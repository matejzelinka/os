---
import Card from "./ui/Card.astro";

interface Props {
	title: string;
	value: string;
	icon: string;
}

const { title, value, icon } = Astro.props;
---

<Card class="p-6">

<div class="flex items-center justify-between">

<div>

<p class="text-sm text-zinc-500">
{title}
</p>

<h3 class="mt-2 text-3xl font-bold">
{value}
</h3>

</div>

<div class="text-4xl">
{icon}
</div>

</div>

</Card>