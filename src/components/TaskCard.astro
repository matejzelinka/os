---
interface Props {
	title: string;
	project: string;
}

const { title, project } = Astro.props;
---

<div class="flex items-center justify-between rounded-2xl border bg-white p-5 shadow-sm">
	<div>
		<h3 class="font-semibold">{title}</h3>
		<p class="mt-1 text-sm text-zinc-500">{project}</p>
	</div>
</div>
