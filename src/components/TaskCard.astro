---
interface Props {
	title: string;
	project: string;
	priority?: "high" | "medium" | "low";
}

const { title, project, priority = "medium" } = Astro.props;

const colors = {
	high: "bg-red-500",
	medium: "bg-orange-400",
	low: "bg-green-500"
};
---

<div class="flex items-center justify-between rounded-2xl border bg-white p-5 shadow-sm">

	<div>

		<h3 class="font-semibold">
			{title}
		</h3>

		<p class="mt-1 text-sm text-zinc-500">
			{project}
		</p>

	</div>

	<div class={`h-3 w-3 rounded-full ${colors[priority]}`}></div>

</div>