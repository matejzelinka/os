---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
import CalendarPage from "../components/dashboard/calendar/CalendarPage";
---

<Layout title="Kalendář">
  <div class="flex min-h-screen bg-zinc-100">
    <Sidebar />
    <main class="min-w-0 flex-1">
      <Topbar />
      <div class="mx-auto max-w-6xl px-4 py-5 pb-24 sm:px-6 md:p-8">
        <CalendarPage client:only="react" />
      </div>
    </main>
  </div>
</Layout>
